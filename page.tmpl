<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.Title}} — cohort review</title>
<!-- Restore the saved theme before first paint, so a light-mode user doesn't
     get a dark flash on every load. -->
<script>{ const t = localStorage.getItem("theme"); if (t) document.documentElement.setAttribute("data-theme", t); }</script>
<link rel="stylesheet" href="/assets/ibm-plex.css">
<link rel="stylesheet" href="/assets/diff2html.min.css">
<link rel="stylesheet" href="/assets/github.min.css" id="hl-light" disabled>
<link rel="stylesheet" href="/assets/github-dark.min.css" id="hl-dark">
<script src="/assets/diff2html.min.js"></script>
<script src="/assets/diff2html-ui.min.js"></script>
<style>
  /* Styled after the "Change Stack Viewer" design canvas: a dark, layered
     review shell in IBM Plex. Dark is the default because the design has no
     light counterpart; the toggle's light palette is derived from it. */
  :root {
    color-scheme: dark;
    --accent:#7c3aed; --accent-ink:#fff; --accent-soft:rgba(124,58,237,.16);

    --bg:#0d0d0f;       /* header + page ground */
    --canvas:#121215;   /* main column */
    --rail:#0b0b0d;     /* sidebar */
    --rail-hover:#141418;
    --card:#0f0f12;     /* diff card body */
    --panel:#17171b;    /* controls, card headers, hunk bars */
    --panel-2:#1e1e23;  /* hover / pressed */
    --panel-3:#1b1b21;  /* selected row */

    --line:#232329; --line-2:#26262c; --line-3:#2b2b32;
    --line-4:#1e1e23; --line-5:#1c1c21; --line-hover:#3a3a43;

    --ink:#e7e7ea; --ink-hi:#f2f2f4; --ink-2:#b9b9c2; --ink-3:#9a9aa3;
    --muted:#8c8c95; --muted-2:#7d7d87; --faint:#6a6a74; --faintest:#4d4d55;

    --chip-bg:#1c1c21; --chip-line:#2a2a31; --chip-ink:#a3a3ac;

    --gutter:#101013; --gutter-ink:#5f5f69; --code-ink:#b9b9c2;
    --add:#3fb950; --add-num:#7ee787; --add-code:#d7e6d9;
    --add-bg:rgba(63,185,80,.13); --add-bg-2:rgba(63,185,80,.09); --add-hi:rgba(63,185,80,.3);
    --del:#f85149; --del-num:#ffa198; --del-code:#e8d8d6;
    --del-bg:rgba(248,81,73,.13); --del-bg-2:rgba(248,81,73,.09); --del-hi:rgba(248,81,73,.3);
    --stat-add:#56d364; --stat-del:#ff7b72;
    --chg-add:var(--add-bg-2); --chg-del:var(--del-bg-2); --chg-ink:var(--chip-ink);

    --link:#b892ff; --link-h:#d3bcff;
    --hatch:repeating-linear-gradient(45deg,rgba(255,255,255,.09) 0 1px,transparent 1px 7px);

    --sans:'IBM Plex Sans',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    --mono:'IBM Plex Mono',ui-monospace,"SF Mono","SFMono-Regular",Menlo,Consolas,monospace;
  }
  :root[data-theme="light"] {
    color-scheme: light;
    --accent:#6d28d9; --accent-ink:#fff; --accent-soft:rgba(109,40,217,.1);

    --bg:#fff; --canvas:#f7f7f9; --rail:#fbfbfc; --rail-hover:#f1f1f4;
    --card:#fff; --panel:#f2f2f5; --panel-2:#e9e9ee; --panel-3:#f0ecfb;

    --line:#e4e4ea; --line-2:#e4e4ea; --line-3:#d8d8e0;
    --line-4:#ededf1; --line-5:#ededf1; --line-hover:#c3c3cd;

    --ink:#1c1c22; --ink-hi:#0e0e12; --ink-2:#3f3f4a; --ink-3:#5f5f6c;
    --muted:#71717f; --muted-2:#82828f; --faint:#9a9aa6; --faintest:#c2c2cc;

    --chip-bg:#f2f2f5; --chip-line:#e0e0e7; --chip-ink:#5f5f6c;

    --gutter:#f6f6f9; --gutter-ink:#9a9aa6; --code-ink:#26262e;
    --add:#1f9c4d; --add-num:#146c31; --add-code:#14351f;
    --add-bg:rgba(31,156,77,.15); --add-bg-2:rgba(31,156,77,.08); --add-hi:rgba(31,156,77,.3);
    --del:#d1332b; --del-num:#a11b16; --del-code:#43140f;
    --del-bg:rgba(209,51,43,.13); --del-bg-2:rgba(209,51,43,.07); --del-hi:rgba(209,51,43,.28);
    --stat-add:#1a7f37; --stat-del:#c0362c;
    --chg-add:var(--add-bg-2); --chg-del:var(--del-bg-2); --chg-ink:var(--chip-ink);

    --link:#6d28d9; --link-h:#5b21b6;
    --hatch:repeating-linear-gradient(45deg,rgba(0,0,0,.10) 0 1px,transparent 1px 7px);
  }

  /* diff2html is re-skinned through its own custom properties rather than by
     out-specifying its selectors. applyDark() toggles .d2h-dark-color-scheme,
     which is what picks the --d2h-dark-* set over the base set. */
  :root {
    --d2h-dark-bg-color:var(--gutter); --d2h-dark-color:var(--code-ink);
    --d2h-dark-border-color:var(--line-2); --d2h-dark-dim-color:var(--gutter-ink);
    --d2h-dark-line-border-color:var(--line-5);
    --d2h-dark-file-header-bg-color:var(--panel); --d2h-dark-file-header-border-color:var(--line-2);
    --d2h-dark-empty-placeholder-bg-color:var(--gutter); --d2h-dark-empty-placeholder-border-color:var(--line-2);
    --d2h-dark-selected-color:var(--accent-soft);
    --d2h-dark-ins-bg-color:var(--add-bg-2); --d2h-dark-ins-border-color:var(--add);
    --d2h-dark-ins-highlight-bg-color:var(--add-hi); --d2h-dark-ins-label-color:var(--stat-add);
    --d2h-dark-del-bg-color:var(--del-bg-2); --d2h-dark-del-border-color:var(--del);
    --d2h-dark-del-highlight-bg-color:var(--del-hi); --d2h-dark-del-label-color:var(--stat-del);
    --d2h-dark-info-bg-color:var(--panel); --d2h-dark-info-border-color:var(--line-2);
    --d2h-dark-change-ins-color:var(--chg-add); --d2h-dark-change-del-color:var(--chg-del);
    --d2h-dark-change-label-color:var(--chg-ink);

    --d2h-bg-color:var(--gutter); --d2h-border-color:var(--line-2);
    --d2h-dim-color:var(--gutter-ink); --d2h-line-border-color:var(--line-5);
    --d2h-file-header-bg-color:var(--panel); --d2h-file-header-border-color:var(--line-2);
    --d2h-empty-placeholder-bg-color:var(--gutter); --d2h-empty-placeholder-border-color:var(--line-2);
    --d2h-selected-color:var(--accent-soft);
    --d2h-ins-bg-color:var(--add-bg-2); --d2h-ins-border-color:var(--add);
    --d2h-ins-highlight-bg-color:var(--add-hi); --d2h-ins-label-color:var(--stat-add);
    --d2h-del-bg-color:var(--del-bg-2); --d2h-del-border-color:var(--del);
    --d2h-del-highlight-bg-color:var(--del-hi); --d2h-del-label-color:var(--stat-del);
    --d2h-info-bg-color:var(--panel); --d2h-info-border-color:var(--line-2);
    --d2h-change-ins-color:var(--chg-add); --d2h-change-del-color:var(--chg-del);
    --d2h-change-label-color:var(--chg-ink);
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; }
  /* The shell owns the viewport: header pinned, sidebar and main scroll
     independently. IntersectionObserver still fires against the viewport, so
     lazy cohort rendering is unaffected. */
  body { height: 100vh; overflow: hidden; display: flex; flex-direction: column;
    background: var(--bg); color: var(--ink); font-family: var(--sans); font-size: 14px;
    -webkit-font-smoothing: antialiased; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: var(--canvas); }
  ::-webkit-scrollbar-thumb { background: var(--line-3); border-radius: 6px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--line-hover); }
  a { color: var(--link); text-decoration: none; }
  a:hover { color: var(--link-h); }

  .btn { display: inline-flex; align-items: center; gap: 8px; background: var(--panel);
    border: 1px solid var(--line-3); color: var(--ink); font-family: var(--sans); font-size: 13px;
    font-weight: 500; padding: 8px 13px; border-radius: 8px; cursor: pointer; white-space: nowrap; }
  .btn:hover { background: var(--panel-2); border-color: var(--line-hover); color: var(--ink); }
  .btn:disabled { color: var(--muted-2); cursor: wait; }
  .icon-btn { width: 34px; height: 34px; padding: 0; display: grid; place-items: center;
    background: var(--panel); border: 1px solid var(--line-3); border-radius: 8px;
    color: var(--ink-3); cursor: pointer; flex: none; }
  .icon-btn:hover { background: var(--panel-2); border-color: var(--line-hover); color: var(--ink); }
  .chip { padding: 3px 8px; border-radius: 6px; background: var(--chip-bg);
    border: 1px solid var(--chip-line); color: var(--chip-ink); font-size: 11.5px;
    font-family: var(--mono); white-space: nowrap; }
  .label { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }

  .topbar { flex: none; display: flex; align-items: flex-start; gap: 16px; padding: 14px 18px 12px;
    background: var(--bg); border-bottom: 1px solid var(--line); }
  .pill { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px 5px 9px;
    border-radius: 999px; background: var(--accent); color: var(--accent-ink); font-size: 12.5px;
    font-weight: 600; flex: none; margin-top: 2px; }
  .tb-main { flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .tb-title { margin: 0; font-size: 16.5px; font-weight: 600; letter-spacing: -.01em;
    color: var(--ink-hi); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tb-meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-family: var(--mono);
    font-size: 12.5px; color: var(--muted); }
  .tb-meta .sep { color: var(--faintest); }
  .tb-meta .repo { display: flex; align-items: center; gap: 6px; }
  .tb-meta .repo i { width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid var(--muted-2); }
  .tb-actions { display: flex; align-items: center; gap: 8px; flex: 0 1 auto; min-width: 0; }
  .loadf { display: flex; gap: 6px; flex: 0 1 auto; min-width: 0; }
  /* Shrinks before the PR title does — at 150% zoom a fixed width here left
     the title as three ellipsised characters. */
  .loadf input { font-family: var(--mono); font-size: 12.5px; flex: 0 1 244px; width: 244px;
    min-width: 108px; padding: 8px 12px;
    background: var(--panel); color: var(--ink); border: 1px solid var(--line-3); border-radius: 8px; }
  .loadf input::placeholder { color: var(--muted-2); }
  .loadf input:focus { outline: none; border-color: var(--accent); }

  .app { flex: 1; min-height: 0; display: flex; position: relative; }
  .sidebar { width: var(--sidebar-w, 288px); flex: none; background: var(--rail);
    border-right: 1px solid var(--line); display: flex; flex-direction: column; overflow: hidden; }
  .side-head { display: flex; align-items: center; gap: 8px; padding: 14px 14px 8px; }
  .side-head .cnt { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted);
    background: var(--panel); border: 1px solid var(--line-3); border-radius: 999px; padding: 2px 8px; }
  .side-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: 0 8px 12px; }
  .side-foot { flex: none; border-top: 1px solid var(--line-4); padding: 12px 16px 14px;
    display: flex; flex-direction: column; gap: 6px; }
  .side-foot .line { font-family: var(--mono); font-size: 11.5px; color: var(--muted-2); }
  /* Absolutely positioned over the column edge so it doesn't scroll with
     either pane. */
  .rsz { position: absolute; top: 0; left: calc(var(--sidebar-w, 288px) - 3px); width: 6px;
    height: 100%; cursor: col-resize; z-index: 5; }
  .rsz:hover { background: var(--accent-soft); }
  body.resizing { cursor: col-resize; user-select: none; }

  .nav-coh { margin-bottom: 2px; }
  .nch { display: flex; flex-direction: column; gap: 8px; padding: 11px 12px; border-radius: 9px;
    cursor: pointer; border: 1px solid transparent; }
  .nch:hover { background: var(--rail-hover); }
  .nch.on { background: var(--panel-3); border-color: var(--line-3);
    box-shadow: inset 2px 0 0 var(--coh); }
  .nch-top { display: flex; align-items: baseline; gap: 10px; min-width: 0; }
  .nch-n { width: 12px; flex: none; font-family: var(--mono); font-size: 12px; color: var(--faint); }
  .nch.on .nch-n { color: var(--coh); }
  .nch-t { font-size: 13.5px; font-weight: 500; color: var(--ink-2); line-height: 1.35;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nch.on .nch-t { font-weight: 600; color: var(--ink-hi); }
  .nch-chips { display: flex; align-items: center; gap: 8px; padding-left: 22px; }
  .nch-chips .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coh);
    margin-left: auto; flex: none; }
  /* Only the cohort being read lists its files. Every list open at once made
     the sidebar a flat roll of every file in the PR — the design shows cohort
     rows alone. Keyed off .nch.on, which syncActive already maintains, so
     selection and expansion can't disagree. */
  .nav-files { display: none; list-style: none; margin: 0 0 6px; padding: 0 0 0 34px; }
  .nch.on + .nav-files { display: block; }
  .nav-files li { font-family: var(--mono); font-size: 11.5px; color: var(--muted); padding: 4px 8px;
    border-radius: 6px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    direction: rtl; text-align: left; }
  .nav-files li:hover { background: var(--panel-2); color: var(--ink); }
  .nav-files li.on { background: var(--panel-3); color: var(--ink-hi); }
  .nav-files li span { direction: ltr; unicode-bidi: bidi-override; }

  main { flex: 1; min-width: 0; overflow-y: auto; background: var(--canvas); }
  .intro { padding: 22px 30px 0; }
  .intro-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
  .walk-toggle { background: none; border: 0; padding: 0; cursor: pointer; color: var(--link);
    font-family: var(--mono); font-size: 11.5px; }
  .walk-toggle:hover { color: var(--link-h); }
  .walk { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--ink-3); max-width: 78ch;
    text-wrap: pretty; }
  /* The walkthrough describes the whole PR and is read once, but it sits above
     every file you page to — so it opens clamped and expands on demand. */
  .walk.clamped { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    overflow: hidden; }
  .toolbar { display: flex; align-items: center; gap: 10px; padding: 22px 30px 20px; }
  .toolbar .spacer { flex: 1; }
  /* The design's file pager: ‹ | File N of M ▾ | ›. Only paged mode shows one
     file at a time, so all mode hides it. */
  .file-nav { display: flex; align-items: stretch; border: 1px solid var(--line-3);
    border-radius: 9px; overflow: hidden; background: var(--panel); }
  .file-nav button { background: none; border: 0; color: var(--ink); cursor: pointer;
    font-family: var(--sans); font-size: 13px; font-weight: 500; }
  .fn-arrow { width: 36px; display: grid; place-items: center; font-size: 15px; }
  .fn-arrow:first-child { border-right: 1px solid var(--line-3); }
  .fn-arrow:last-child { border-left: 1px solid var(--line-3); }
  .file-nav button:hover:not(:disabled) { background: var(--panel-2); }
  .file-nav button:disabled { color: var(--faintest); cursor: default; }
  /* A native select laid transparently over the label: real dropdown, keyboard
     and a11y for free, and the design's look kept — no custom popover. */
  .fn-label { position: relative; display: flex; align-items: center; gap: 9px;
    padding: 9px 14px; font-size: 13px; font-weight: 500; color: var(--ink); white-space: nowrap; }
  .fn-label:hover { background: var(--panel-2); }
  .fn-label .fn-caret { color: var(--muted-2); font-size: 10px; }
  .fn-label select { position: absolute; inset: 0; width: 100%; height: 100%;
    opacity: 0; cursor: pointer; font-family: var(--mono); font-size: 12px; }
  .fn-path { font-family: var(--mono); font-size: 12.5px; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 42ch;
    direction: rtl; text-align: left; }
  .fn-path span { direction: ltr; unicode-bidi: bidi-override; }
  /* The sidebar is the only cohort navigation there is, so when the narrow
     layout drops it, paged mode would strand you on one cohort. This takes
     over there and is redundant while the sidebar is up. */
  .coh-pick { display: none; }
  .coh-pick select { font-family: var(--mono); font-size: 12.5px; padding: 9px 12px; width: 100%;
    background: var(--panel); color: var(--ink); border: 1px solid var(--line-3);
    border-radius: 9px; cursor: pointer; }
  .seg { display: flex; align-items: stretch; border: 1px solid var(--line-3); border-radius: 9px;
    overflow: hidden; background: var(--panel); }
  .seg button { background: none; border: 0; color: var(--muted); font-family: var(--mono);
    font-size: 12.5px; font-weight: 500; padding: 9px 14px; cursor: pointer; }
  .seg button + button { border-left: 1px solid var(--line-3); }
  .seg button:hover { background: var(--panel-2); color: var(--ink); }
  .seg button.on { background: var(--accent); color: var(--accent-ink); }

  /* One cohort per page, so its header is the page heading — the design's
     25px h1 + blurb slot, which previously had nothing to hold. */
  .cohort { padding: 0 30px 44px; }
  .coh-head { display: flex; align-items: center; gap: 11px; }
  .coh-n { width: 12px; flex: none; font-family: var(--mono); font-size: 13px; color: var(--coh); }
  .coh-head h2 { margin: 0; font-size: 25px; font-weight: 600; letter-spacing: -.015em;
    color: var(--ink-hi); }
  .coh-stat { margin-left: auto; display: flex; align-items: center; gap: 10px;
    font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
  .coh-sum { margin: 10px 0 20px; padding-left: 23px; font-size: 14.5px; line-height: 1.55;
    color: var(--ink-3); max-width: 78ch; text-wrap: pretty; }
  .coh-pending { color: var(--muted); font-family: var(--mono); font-size: 12px; padding: 16px 4px; }

  /* Structural diff2html overrides — the parts its custom properties don't
     reach (metrics, radii, and the split between gutter and code tints). */
  .d2h-wrap .d2h-file-wrapper { background: var(--card); border: 1px solid var(--line-2);
    border-radius: 12px; overflow: hidden; margin-bottom: 14px; scroll-margin-top: 16px;
    /* content-visibility lets the browser skip layout/paint for file cards that
       are scrolled off-screen — cheap virtualization for a long diff. The
       intrinsic-size is a rough placeholder so the scrollbar stays sane. */
    content-visibility: auto; contain-intrinsic-size: 0 320px; }
  .d2h-wrap .d2h-file-header { height: auto; min-height: 45px; padding: 10px 14px; gap: 10px;
    align-items: center; font-family: var(--sans); }
  .d2h-wrap .d2h-file-name-wrapper { align-items: center; gap: 9px; font-size: 13.5px;
    color: var(--muted); min-width: 0; }
  .d2h-wrap .d2h-file-name { font-family: var(--mono); font-size: 13.5px; color: var(--ink-hi); }
  .d2h-wrap .d2h-icon { margin-right: 0; flex: none; }
  .d2h-wrap .d2h-tag { font-family: var(--mono); font-size: 10.5px; line-height: 1.5;
    padding: 1px 7px; border-radius: 6px; background: var(--chip-bg); margin-left: 2px; flex: none; }
  .d2h-wrap .d2h-file-stats { gap: 7px; font-family: var(--mono); font-size: 12.5px; flex: none; }
  .d2h-wrap .d2h-lines-added, .d2h-wrap .d2h-lines-deleted { border: 0; border-radius: 0;
    padding: 0; margin: 0; }
  .d2h-wrap .d2h-file-collapse { display: flex; flex: none; gap: 7px; padding: 6px 12px;
    border-radius: 8px; border: 1px solid var(--line-3); background: var(--panel-2);
    color: var(--ink-2); font-family: var(--sans); font-size: 12.5px; font-weight: 500; }
  .d2h-wrap .d2h-file-collapse:hover { border-color: var(--line-hover); }
  .d2h-wrap .d2h-file-collapse-input { accent-color: var(--accent); margin: 0; }
  .d2h-wrap .d2h-diff-table { font-family: var(--mono); font-size: 12.75px; line-height: 22px; }
  /* Long lines have to be reachable: the card clips (for its radius), so the
     code body is what scrolls. */
  .d2h-wrap .d2h-file-diff { overflow-x: auto; }
  .d2h-wrap .d2h-info { padding-left: 4px; font-family: var(--mono); font-size: 12.5px; }
  /* The design tints the line-number gutter harder than the code cell and
     marks the change with a 3px edge, so the two halves need separate rules. */
  .d2h-wrap .d2h-code-linenumber.d2h-ins, .d2h-wrap .d2h-code-side-linenumber.d2h-ins {
    background: var(--add-bg); color: var(--add-num); border-left: 3px solid var(--add); }
  .d2h-wrap .d2h-code-linenumber.d2h-del, .d2h-wrap .d2h-code-side-linenumber.d2h-del {
    background: var(--del-bg); color: var(--del-num); border-left: 3px solid var(--del); }
  .d2h-wrap td.d2h-ins .d2h-code-line-ctn, .d2h-wrap td.d2h-ins .d2h-code-line-prefix { color: var(--add-code); }
  .d2h-wrap td.d2h-del .d2h-code-line-ctn, .d2h-wrap td.d2h-del .d2h-code-line-prefix { color: var(--del-code); }
  .d2h-wrap .d2h-file-diff .d2h-code-linenumber.d2h-ins.d2h-change,
  .d2h-wrap .d2h-files-diff .d2h-code-side-linenumber.d2h-ins.d2h-change { background: var(--add-bg); }
  .d2h-wrap .d2h-file-diff .d2h-code-linenumber.d2h-del.d2h-change,
  .d2h-wrap .d2h-files-diff .d2h-code-side-linenumber.d2h-del.d2h-change { background: var(--del-bg); }
  .d2h-wrap .d2h-files-diff .d2h-emptyplaceholder,
  .d2h-wrap .d2h-files-diff .d2h-code-side-emptyplaceholder { background-image: var(--hatch); }
  .d2h-wrap .d2h-file-side-diff + .d2h-file-side-diff { border-left: 1px solid var(--line-2); }
  /* The hljs themes paint a block background on every highlighted element,
     which fights the diff's added/removed row colors — highlighting must
     only color tokens. */
  .d2h-wrap .hljs { background: transparent; padding: 0; }

  /* Large/generated files (lockfiles, minified assets, huge hunks) render as a
     placeholder card so one blob can't blow up the page; the expensive
     diff2html draw + highlight pass runs only if the user expands it. */
  .cr-file { scroll-margin-top: 16px; }
  .cr-big { background: var(--card); border: 1px solid var(--line-2); border-radius: 12px;
    overflow: hidden; margin-bottom: 14px; }
  .cr-big .cr-name { display: flex; align-items: center; gap: 9px; min-height: 45px;
    padding: 10px 14px; background: var(--panel); border-bottom: 1px solid var(--line-2);
    font-family: var(--mono); font-size: 13.5px; color: var(--ink-hi); }
  .cr-show { display: flex; align-items: center; gap: 9px; width: 100%; text-align: left;
    cursor: pointer; font-family: var(--mono); font-size: 12.5px; color: var(--link);
    background: none; border: 0; padding: 12px 14px; }
  .cr-show:hover { background: var(--panel); }
  .loading { color: var(--muted); font-family: var(--mono); font-size: 13px; padding: 40px 30px; }

  @media (max-width: 900px) {
    /* The document scrolls here, not main — see scroller() in the script. */
    .app { display: block; }
    body { height: auto; overflow: visible; }
    .sidebar, .rsz { display: none; }
    main { overflow: visible; }
    .topbar { flex-wrap: wrap; }
    .tb-actions { flex: 1 1 100%; }
    .coh-pick { display: flex; flex: 1 1 auto; min-width: 0; }
    .cohort, .toolbar, .intro { padding-left: 16px; padding-right: 16px; }
  }
</style>
</head>
<body>

<header class="topbar">
  <span class="pill">
    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><circle cx="3" cy="3" r="2" stroke="currentColor" stroke-width="1.4"></circle><circle cx="3" cy="9.5" r="1.6" fill="currentColor"></circle><path d="M3 5v2.4M5 3h3.2a1.6 1.6 0 0 1 1.6 1.6V8" stroke="currentColor" stroke-width="1.3"></path></svg>
    Local
  </span>
  <div class="tb-main">
    <h1 class="tb-title" id="pr-title"></h1>
    <div class="tb-meta" id="meta"></div>
  </div>
  <div class="tb-actions">
    <a class="btn" id="pr-link" target="_blank" rel="noopener" hidden>view on Bitbucket ↗</a>
    <form class="loadf" action="/load"
      onsubmit="const b=this.querySelector('button'); b.disabled=true; b.textContent='grouping…';">
      <input name="pr" required placeholder="switch PR: paste bitbucket URL">
      <button class="btn">load</button>
    </form>
    <button class="icon-btn" onclick="toggleTheme()" title="toggle theme" aria-label="toggle theme">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"></circle><path d="M8 2a6 6 0 0 1 0 12Z" fill="currentColor"></path></svg>
    </button>
  </div>
</header>

<div class="app">
  <aside class="sidebar">
    <div class="side-head">
      <span class="label">Cohorts</span>
      <span class="cnt" id="coh-count"></span>
    </div>
    <div class="side-scroll"><nav id="nav"></nav></div>
    <div class="side-foot">
      <span class="label">Rendered by</span>
      <span class="line">diff2html · localhost only</span>
    </div>
  </aside>
  <div class="rsz" id="rsz" title="drag to resize"></div>
  <main id="main">
    <div class="intro" id="intro" hidden>
      <div class="intro-head">
        <span class="label">Walkthrough</span>
        <button class="walk-toggle" id="walk-toggle" onclick="toggleWalk()" hidden>more</button>
      </div>
      <p class="walk clamped" id="walk"></p>
    </div>
    <div class="toolbar">
      <label class="coh-pick"><select id="coh-select" onchange="go(+this.value)"></select></label>
      <span class="file-nav" id="file-nav">
        <button class="fn-arrow" id="fn-prev" onclick="stepFile(-1)" aria-label="previous file">‹</button>
        <span class="fn-label"><span id="fn-text">File 1 of 1</span><span class="fn-caret">▾</span>
          <select id="fn-select" aria-label="choose file in this cohort" onchange="goFile(+this.value)"></select></span>
        <button class="fn-arrow" id="fn-next" onclick="stepFile(1)" aria-label="next file">›</button>
      </span>
      <span class="fn-path" id="fn-path"></span>
      <span class="spacer"></span>
      <span class="seg"><button id="m-paged" onclick="go(ACTIVE, 'paged')">paged</button><button id="m-all" onclick="go(ACTIVE, 'all')">all cohorts</button></span>
      <span class="seg"><button id="ll" onclick="setFmt('line-by-line')">line-by-line</button><button id="sbs" onclick="setFmt('side-by-side')">side-by-side</button></span>
    </div>
    <div id="sections"><div class="loading">loading diff…</div></div>
  </main>
</div>

<script>const PAGE = {{.Page}};</script>
<script>
  // Glue adapted from the prototype artifact; data comes from PAGE and the
  // diff from /diff.txt (fetched, never inlined — see server.go newMux).
  const PALETTE = ["#7c3aed", "#2f81f7", "#1f9c6b", "#e0662a", "#c05fd6", "#3fb6c4", "#d9a441", "#e05a7d"];
  const COHORTS = PAGE.cohorts.map((c, i) => ({ ...c, color: PALETTE[i % PALETTE.length] }));

  // fileBlocks: path → {block, parts}. parts mirrors Go's splitSegmentHunks:
  // parts[0] is the file header, hunk N is parts[N]. parts = null marks the
  // path unsplittable — hunk refs then render the whole block instead.
  let fileBlocks = {};

  // Paths whose whole block was already emitted this build: an unsplittable
  // path referenced from several cohorts renders at its FIRST ref only, so the
  // full diff stays on the page exactly once. Reset by every build().
  let renderedWhole = {};

  // markUnsplittable runs once, BEFORE any rendering: an out-of-range hunk
  // index means our split disagrees with the server's ground truth, so the
  // whole path degrades to unsplittable. Deciding upfront (not lazily inside
  // subFor) is what keeps the diff exactly-once — a lazy downgrade after an
  // earlier ref already rendered a subset would re-render those hunks.
  function markUnsplittable() {
    COHORTS.forEach(c => c.files.forEach(p => {
      const fb = fileBlocks[p.path];
      if (p.hunks && fb && fb.parts && p.hunks.some(n => n < 1 || n >= fb.parts.length)) fb.parts = null;
    }));
  }

  // subFor renders one cohort entry: a validated hunk subset, or the whole
  // block exactly once (at the path's first whole/unsplittable ref).
  function subFor(ref) {
    const fb = fileBlocks[ref.path];
    if (!fb) return "";
    if (ref.hunks && fb.parts) return fb.parts[0] + ref.hunks.map(n => fb.parts[n]).join("");
    if (renderedWhole[ref.path]) return "";
    renderedWhole[ref.path] = true;
    return fb.block;
  }
  const esc = s => s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  let FMT = PAGE.format;
  let io = null;              // IntersectionObserver driving lazy cohort render
  // per-cohort: { subs, parsedSubs, present, hosted, drawn:Set(fi), rendered }
  const cohortState = [];

  // Two ways to read the same cohorts, both linkable as #<mode>/<n>:
  //   paged — one cohort on screen, chosen from the sidebar (the default)
  //   all   — every cohort in one scroll, which is what keeps ctrl-F over the
  //           whole PR possible
  // Both modes share one set of section elements and one cohortState, so a
  // cohort drawn in either mode stays drawn, and its Viewed checkboxes (DOM
  // state inside the diff) survive switching cohort or mode.
  // Paged mode shows one FILE of one cohort, stepped with the ‹ › pager — the
  // design's unit of reading. AF indexes cohortState[ACTIVE].present (the
  // files that actually have a block this build), which is also what the
  // "File N of M" counter counts.
  let MODE = "paged";
  let ACTIVE = 0;
  let AF = 0;

  // Which element actually scrolls: main on desktop, the document once the
  // narrow layout un-pins the shell. Driving main.scrollTop there is a no-op,
  // which silently broke every navigation path below 900px.
  function scroller() {
    const m = document.getElementById("main");
    const ov = getComputedStyle(m).overflowY;
    return ov === "auto" || ov === "scroll" ? m : document.scrollingElement;
  }
  // Offset of an element from the top of whatever is scrolling.
  function topWithin(el, sc) {
    const base = sc === document.scrollingElement ? 0 : sc.getBoundingClientRect().top;
    return el.getBoundingClientRect().top - base;
  }

  function build() {
    document.title = PAGE.title + " — cohort review";
    document.getElementById("pr-title").textContent = PAGE.title;
    document.getElementById("walk").textContent = PAGE.walkthrough;
    document.getElementById("intro").hidden = !PAGE.walkthrough;
    setupWalk();
    const link = document.getElementById("pr-link");
    link.href = PAGE.url;
    link.hidden = !PAGE.url;

    const nav = document.getElementById("nav");
    const sections = document.getElementById("sections");
    nav.innerHTML = ""; sections.innerHTML = "";
    renderedWhole = {};
    if (io) io.disconnect();
    cohortState.length = 0;
    let tAdd = 0, tDel = 0;
    const nFiles = new Set(COHORTS.flatMap(c => c.files.map(f => f.path))).size;

    COHORTS.forEach((c, ci) => {
      const subs = c.files.map(subFor);
      // Parsed per sub so renderCohort can spot large files BEFORE the
      // expensive diff2html draw + highlight pass touches them.
      const parsedSubs = subs.map(s => s ? Diff2Html.parse(s) : []);
      const parsed = parsedSubs.flat();
      const cAdd = parsed.reduce((s, f) => s + (f.addedLines || 0), 0);
      const cDel = parsed.reduce((s, f) => s + (f.deletedLines || 0), 0);
      tAdd += cAdd; tDel += cDel;

      // present: cohort file indices with a non-empty sub this build (computed
      // after subFor so an unsplittable downgrade is reflected). Each gets its
      // own host card in renderCohort, which is what the f-ci-fi anchors and
      // jumpFile rely on.
      const present = c.files.map((p, fi) => fi).filter(fi => subs[fi]);
      cohortState[ci] = { subs, parsedSubs, present, rendered: false, hosted: false, drawn: new Set() };

      // Partial refs get a "k/M hunks" suffix.
      const label = p => {
        const fb = fileBlocks[p.path];
        const m = p.hunks && fb && fb.parts ? ` (${p.hunks.length}/${fb.parts.length - 1})` : "";
        return esc(p.path) + m;
      };
      const n = String(ci + 1);
      nav.insertAdjacentHTML("beforeend",
        `<div class="nav-coh" style="--coh:${c.color}"><div class="nch" id="nch-${ci}" onclick="go(${ci})">
          <div class="nch-top"><span class="nch-n">${n}</span><span class="nch-t">${esc(c.name)}</span></div>
          <div class="nch-chips"><span class="chip">${c.files.length} files</span>
            <span class="chip"><span style="color:var(--stat-add)">+${cAdd}</span> <span style="color:var(--stat-del)">−${cDel}</span></span>
            <span class="dot"></span></div>
        </div>
        <ul class="nav-files">${c.files.map((p, fi) => `<li id="nf-${ci}-${fi}" onclick="jumpFile(${ci}, ${fi})" title="${esc(p.path)}"><span>${label(p)}</span></li>`).join("")}</ul></div>`);

      // Only the section shell (header, stats, empty wrap) is built here; the
      // diff is drawn by renderCohort, on selection in paged mode and on
      // approach in all mode. Hidden until applyMode decides.
      sections.insertAdjacentHTML("beforeend",
        `<section class="cohort" id="coh-${ci}" data-ci="${ci}" style="--coh:${c.color}" hidden>
          <div class="coh-head">
            <span class="coh-n">${n}</span>
            <h2>${esc(c.name)}</h2>
            <span class="coh-stat"><span style="color:var(--stat-add)">+${cAdd}</span>
              <span style="color:var(--stat-del)">−${cDel}</span>
              <span>${parsed.length} files</span></span>
          </div>
          <p class="coh-sum">${esc(c.summary)}</p>
          <div class="d2h-wrap" id="wrap-${ci}"><div class="coh-pending">rendering…</div></div>
        </section>`);
    });

    document.getElementById("coh-select").innerHTML =
      COHORTS.map((c, ci) => `<option value="${ci}">${ci + 1}. ${esc(c.name)}</option>`).join("");
    document.getElementById("coh-count").textContent = COHORTS.length;
    document.getElementById("meta").innerHTML =
      `<span class="repo"><i></i>cohort review</span><span class="sep">·</span>` +
      `<span>${COHORTS.length} cohorts</span><span class="sep">·</span>` +
      `<span>${nFiles} files</span><span class="sep">·</span>` +
      `<span><span style="color:var(--stat-add)">+${tAdd}</span> <span style="color:var(--stat-del)">−${tDel}</span></span>`;
    setFmtButtons();
    applyDark();
    const t = parseHash();
    go(t.ci, t.mode, false, t.af);
  }

  // renderCohort draws one cohort's diff on demand (idempotent). Splitting the
  // draw out of build() is what makes lazy rendering possible. Each file gets
  // its own host div: large files are spotted from the parse BEFORE diff2html
  // draws or highlights anything, and get a placeholder instead — the
  // expensive draw runs only if the user expands them.
  // ensureHosts creates one empty card slot per present file. Cheap, and it
  // has to happen before drawing so a file's card can be shown or hidden
  // without touching what is already drawn inside it.
  function ensureHosts(ci) {
    const st = cohortState[ci];
    if (!st || st.hosted) return;
    st.hosted = true;
    const wrap = document.getElementById(`wrap-${ci}`);
    wrap.innerHTML = "";
    st.present.forEach(fi => {
      const host = document.createElement("div");
      host.className = "cr-file";
      host.id = `f-${ci}-${fi}`;
      wrap.appendChild(host);
    });
  }

  // renderFile draws ONE file's diff (idempotent). Paged mode draws only the
  // file on screen, so opening a ten-file cohort costs one draw, not ten.
  function renderFile(ci, fi) {
    const st = cohortState[ci];
    if (!st || st.drawn.has(fi)) return;
    ensureHosts(ci);
    st.drawn.add(fi);
    const host = document.getElementById(`f-${ci}-${fi}`);
    const files = st.parsedSubs[fi];
    if (files.some(isBigFile)) bigFilePlaceholder(host, st.subs[fi], files);
    else drawDiff(host, st.subs[fi]);
    applyDark();
  }

  // renderCohort draws every file in a cohort — what all mode's observer wants.
  function renderCohort(ci) {
    const st = cohortState[ci];
    if (!st || st.rendered) return;
    st.rendered = true;
    ensureHosts(ci);
    st.present.forEach(fi => renderFile(ci, fi));
    // A drawn cohort changes every later section's offset, so the scroll spy's
    // last answer is stale. Only all mode has a spy to correct.
    if (MODE === "all") syncActive();
  }

  // Diff2HtmlUI (rather than Diff2Html.html) so draw() runs the bundled
  // highlight.js over the rendered lines (highlight: true).
  function drawDiff(host, sub) {
    new Diff2HtmlUI(host, sub,
      { drawFileList: false, matching: "lines", outputFormat: FMT, highlight: true }).draw();
  }

  // diff2html keeps "dev/null" as the null side's name on adds/deletes.
  const fileName = f => (f.newName && !f.newName.includes("dev/null") ? f.newName : f.oldName) || "";

  // isBigFile flags the blobs that make big diffs janky: lockfiles, generated
  // and minified assets, and anything with a very large change count.
  function isBigFile(f) {
    const name = fileName(f);
    if (/(?:^|\/)(?:package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Gemfile\.lock|composer\.lock|Cargo\.lock|poetry\.lock|go\.sum)$/.test(name)) return true;
    if (/(?:^|\/)(?:schema\.rb|structure\.sql)$/.test(name)) return true;
    if (/(?:\.min\.js|\.min\.css|\.map|\.snap|\.pb\.go)$/.test(name)) return true;
    if (/(?:^|\/)(?:dist|vendor|node_modules)\//.test(name)) return true;
    return (f.addedLines || 0) + (f.deletedLines || 0) > 400;
  }

  // bigFilePlaceholder stands in for a large file's card; clicking "show"
  // draws the real diff in place.
  function bigFilePlaceholder(host, sub, files) {
    const add = files.reduce((s, f) => s + (f.addedLines || 0), 0);
    const del = files.reduce((s, f) => s + (f.deletedLines || 0), 0);
    host.innerHTML = `<div class="cr-big"><div class="cr-name">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" style="color:var(--muted)"><path d="M4 2h5l3 3v9H4V2Z" stroke="currentColor" stroke-width="1.4"></path><path d="M9 2v3h3" stroke="currentColor" stroke-width="1.4"></path></svg>
        ${esc(fileName(files[0]))}
        <span style="margin-left:auto;font-size:12.5px"><span style="color:var(--stat-add)">+${add}</span> <span style="color:var(--stat-del)">−${del}</span></span>
      </div>
      <button class="cr-show">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M3 5.5 8 10.5l5-5" stroke="currentColor" stroke-width="1.6"></path></svg>
        show large diff</button></div>`;
    host.querySelector(".cr-show").onclick = () => { drawDiff(host, sub); applyDark(); };
  }

  // Layout is the only thing that changes, and the parsed subs don't depend on
  // it — so throw away just the drawn HTML, and only for cohorts that have any.
  // Unvisited cohorts stay undrawn.
  function setFmt(f) {
    FMT = f;
    setFmtButtons();
    cohortState.forEach((st, ci) => {
      if (!st.drawn.size) return;
      st.rendered = false;
      st.hosted = false;
      st.drawn.clear();
      document.getElementById(`wrap-${ci}`).innerHTML = "";
    });
    applyMode();
  }
  function setFmtButtons() {
    document.getElementById("ll").classList.toggle("on", FMT === "line-by-line");
    document.getElementById("sbs").classList.toggle("on", FMT === "side-by-side");
    document.getElementById("m-paged").classList.toggle("on", MODE === "paged");
    document.getElementById("m-all").classList.toggle("on", MODE === "all");
  }
  const effectiveDark = () => document.documentElement.getAttribute("data-theme") !== "light";
  function applyDark() {
    const dark = effectiveDark();
    document.querySelectorAll(".d2h-wrapper").forEach(el => el.classList.toggle("d2h-dark-color-scheme", dark));
    document.getElementById("hl-light").disabled = dark;
    document.getElementById("hl-dark").disabled = !dark;
  }
  // applyMode shows the right sections and arms the machinery that mode needs.
  // Deferred drawing and the scroll spy only earn their keep in all mode, where
  // every cohort is on the page at once; paged mode draws the one cohort it
  // shows and takes its highlight from the selection.
  function applyMode() {
    const all = MODE === "all";
    COHORTS.forEach((_, i) => { document.getElementById(`coh-${i}`).hidden = !all && i !== ACTIVE; });
    if (io) { io.disconnect(); io = null; }
    if (!all) {
      const st = cohortState[ACTIVE];
      AF = Math.min(Math.max(AF, 0), Math.max(st.present.length - 1, 0));
      ensureHosts(ACTIVE);
      // Only the paged file is visible; the rest keep whatever was drawn in
      // them, so returning to a file keeps its Viewed checkbox.
      st.present.forEach((fi, i) => {
        document.getElementById(`f-${ACTIVE}-${fi}`).hidden = i !== AF;
      });
      if (st.present.length) renderFile(ACTIVE, st.present[AF]);
    } else if ("IntersectionObserver" in window) {
      io = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (e.isIntersecting) { renderCohort(+e.target.dataset.ci); io.unobserve(e.target); }
        }
      }, { rootMargin: "800px 0px" });
      document.querySelectorAll(".cohort").forEach(el => io.observe(el));
    } else {
      COHORTS.forEach((_, ci) => renderCohort(ci));
    }
    // All mode is the long scroll: every card that exists is visible.
    if (all) COHORTS.forEach((c, ci) => cohortState[ci].present.forEach(fi => {
      const h = document.getElementById(`f-${ci}-${fi}`);
      if (h) h.hidden = false;
    }));
    setFmtButtons();
    syncActive();
    syncFileNav();
  }

  // File pager. goFile is navigation like go(): it moves, then records.
  function goFile(af, push = true) {
    const st = cohortState[ACTIVE];
    if (!st.present.length) return;
    AF = Math.min(Math.max(af, 0), st.present.length - 1);
    if (MODE === "all") {
      // No paging in all mode — treat it as "scroll to that file".
      const el = document.getElementById(`f-${ACTIVE}-${st.present[AF]}`);
      renderCohort(ACTIVE);
      if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
      syncFileNav();
      return;
    }
    applyMode();
    scroller().scrollTop = 0;
    const h = `#paged/${ACTIVE + 1}/${AF + 1}`;
    if (push && location.hash !== h) location.hash = h;
  }
  function stepFile(d) { goFile(AF + d); }

  // syncFileNav keeps the pager, its dropdown, and the sidebar file list all
  // reporting the same file.
  function syncFileNav() {
    const st = cohortState[ACTIVE];
    const n = st ? st.present.length : 0;
    document.getElementById("file-nav").hidden = MODE !== "paged";
    document.getElementById("fn-path").hidden = MODE !== "paged";
    if (!st) return;
    document.getElementById("fn-text").textContent = `File ${n ? AF + 1 : 0} of ${n}`;
    document.getElementById("fn-prev").disabled = AF <= 0;
    document.getElementById("fn-next").disabled = AF >= n - 1;
    const paths = st.present.map(fi => COHORTS[ACTIVE].files[fi].path);
    document.getElementById("fn-select").innerHTML =
      paths.map((path, i) => `<option value="${i}">${i + 1}. ${esc(path)}</option>`).join("");
    document.getElementById("fn-select").value = AF;
    document.getElementById("fn-path").innerHTML = n ? `<span>${esc(paths[AF])}</span>` : "";
    COHORTS.forEach((c, ci) => c.files.forEach((_, fi) => {
      const li = document.getElementById(`nf-${ci}-${fi}`);
      if (li) li.classList.toggle("on",
        MODE === "paged" && ci === ACTIVE && st.present[AF] === fi);
    }));
  }

  // Landing on a cohort in all mode is a moving target. File cards use
  // content-visibility, so a card above the target reports its estimated height
  // until it actually paints, then swaps in the real one and pushes the target
  // down — a plain scrollIntoView lands thousands of pixels short. Nudge until
  // the target stops moving, and get out of the way the moment the user scrolls.
  let settleToken = 0;
  function scrollToCohort(ci) {
    const sc = scroller();
    const el = document.getElementById(`coh-${ci}`);
    el.scrollIntoView({ block: "start" });
    const mine = ++settleToken;
    // Spaced over ~1s rather than per-frame: each correction reveals more
    // content-visibility cards above, and they need a beat to lay out before
    // the next measurement means anything. A tall viewport resolves far more
    // per step than a frame budget could absorb.
    let tries = 25;
    const step = () => {
      if (mine !== settleToken || tries-- <= 0) return;
      const top = topWithin(el, sc);
      if (Math.abs(top) < 2) return;
      sc.scrollTop += top;
      setTimeout(step, 40);
    };
    setTimeout(step, 0);
  }
  ["wheel", "touchstart", "keydown"].forEach(t =>
    addEventListener(t, () => settleToken++, { passive: true }));

  // go is the single entry point for navigation: it moves, then records where
  // it moved to. Scrolling in all mode does NOT push history — only explicit
  // navigation does, so back/forward stay meaningful.
  function go(ci, mode = MODE, push = true, af = null) {
    if (!COHORTS[ci]) ci = 0;
    const jumped = mode !== MODE;
    // A different cohort starts at its first file; re-entering the same one
    // (a mode flip, say) keeps the file being read.
    AF = af !== null ? af : (ci === ACTIVE ? AF : 0);
    MODE = mode;
    ACTIVE = ci;
    localStorage.setItem("viewMode", MODE);
    applyMode();
    if (MODE === "all") {
      // Every cohort ABOVE the target has to be drawn before we scroll. Drawing
      // one afterwards (which the observer will) grows the page above the
      // target and shoves it back off-screen — deep-linking to #all/4 landed
      // nowhere near cohort 4 without this.
      for (let i = 0; i <= ci; i++) renderCohort(i);
      scrollToCohort(ci);
    } else {
      scroller().scrollTop = 0;
    }
    const h = MODE === "paged" ? `#paged/${ci + 1}/${AF + 1}` : `#all/${ci + 1}`;
    if (push && location.hash !== h) location.hash = h;
  }

  // Hash wins on load; otherwise the last mode used, like the theme.
  // #paged/<cohort>/<file>, or #all/<cohort>. The file part is optional so an
  // older #paged/3 link still resolves, to that cohort's first file.
  function parseHash() {
    const m = /^#(paged|all)\/(\d+)(?:\/(\d+))?$/.exec(location.hash);
    if (m) return {
      mode: m[1],
      ci: Math.min(Math.max(+m[2] - 1, 0), COHORTS.length - 1),
      af: m[3] ? Math.max(+m[3] - 1, 0) : 0,
    };
    return { mode: localStorage.getItem("viewMode") === "all" ? "all" : "paged", ci: 0, af: 0 };
  }
  addEventListener("hashchange", () => {
    const t = parseHash();
    // go() sets the hash itself; re-entering for a move already made would
    // undo the scroll it just did.
    if (t.mode !== MODE || t.ci !== ACTIVE || (t.mode === "paged" && t.af !== AF)) {
      go(t.ci, t.mode, false, t.af);
    }
  });

  // Sidebar file click. In paged mode that means "page to this file"; in all
  // mode it stays a scroll. A file with no block this build (its hunks render
  // at an earlier cohort's ref) isn't in present — fall back to the cohort.
  function jumpFile(ci, fi) {
    const af = cohortState[ci].present.indexOf(fi);
    if (af < 0) { go(ci); return; }
    if (MODE === "paged") { go(ci, MODE, true, af); return; }
    go(ci);
    AF = af;
    const el = document.getElementById(`f-${ci}-${fi}`) || document.getElementById(`coh-${ci}`);
    if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
    syncFileNav();
  }
  // setupWalk restores the last choice, and hides the toggle when the text is
  // short enough to fit unclamped — no "more" on a two-line walkthrough.
  function setupWalk() {
    const w = document.getElementById("walk");
    const btn = document.getElementById("walk-toggle");
    w.classList.add("clamped");
    const overflows = w.scrollHeight > w.clientHeight + 1;
    btn.hidden = !overflows;
    if (!overflows) { w.classList.remove("clamped"); return; }
    if (localStorage.getItem("walkOpen") === "1") setWalk(false);
    else setWalk(true);
  }
  function setWalk(clamped) {
    document.getElementById("walk").classList.toggle("clamped", clamped);
    document.getElementById("walk-toggle").textContent = clamped ? "more" : "less";
    localStorage.setItem("walkOpen", clamped ? "0" : "1");
  }
  function toggleWalk() {
    setWalk(!document.getElementById("walk").classList.contains("clamped"));
  }

  function toggleTheme() {
    const light = effectiveDark();
    document.documentElement.setAttribute("data-theme", light ? "light" : "dark");
    localStorage.setItem("theme", light ? "light" : "dark");
    applyDark();
  }

  // syncActive keeps the sidebar highlight honest. In all mode that means the
  // cohort nearest the top of the scroller; in paged mode the selection already
  // is the answer.
  function syncActive() {
    if (MODE === "all") {
      const sc = scroller();
      COHORTS.forEach((_, ci) => {
        const el = document.getElementById(`coh-${ci}`);
        if (el && topWithin(el, sc) <= 90) ACTIVE = ci;
      });
    }
    COHORTS.forEach((_, ci) => {
      const row = document.getElementById(`nch-${ci}`);
      if (row) row.classList.toggle("on", ci === ACTIVE);
    });
    document.getElementById("coh-select").value = ACTIVE;
  }
  {
    let queued = false;
    const onScroll = () => {
      if (MODE !== "all" || queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; syncActive(); });
    };
    document.getElementById("main").addEventListener("scroll", onScroll, { passive: true });
    addEventListener("scroll", onScroll, { passive: true });
  }

  // Sidebar resize: drag the right edge; the chosen width persists.
  {
    const saved = localStorage.getItem("sidebarW");
    if (saved) document.documentElement.style.setProperty("--sidebar-w", saved);
    document.getElementById("rsz").addEventListener("mousedown", e => {
      e.preventDefault();
      document.body.classList.add("resizing");
      const move = ev => {
        const w = Math.min(Math.max(ev.clientX, 180), 640) + "px";
        document.documentElement.style.setProperty("--sidebar-w", w);
        localStorage.setItem("sidebarW", w);
      };
      const up = () => {
        document.body.classList.remove("resizing");
        removeEventListener("mousemove", move);
        removeEventListener("mouseup", up);
      };
      addEventListener("mousemove", move);
      addEventListener("mouseup", up);
    });
  }

  fetch("/diff.txt").then(r => r.text()).then(rawDiff => {
    // Index per-file blocks by the path SplitUnifiedDiff would assign (b/ side,
    // falling back to a/ for deletions) so cohort file lists match exactly.
    // A path seen in two segments is appended and marked unsplittable — its
    // concatenated block can't be hunk-indexed, matching the server's
    // bare-only rule for duplicate paths.
    rawDiff.split(/(?=^diff --git )/m).forEach(b => {
      const m = b.match(/^\+\+\+ b\/(.+)$/m) || b.match(/^--- a\/(.+)$/m);
      if (!m) return;
      const fb = fileBlocks[m[1]];
      if (fb) { fb.block += b; fb.parts = null; return; }
      fileBlocks[m[1]] = { block: b, parts: b.split(/(?=^@@ )/m) };
    });
    markUnsplittable();
    build();
  }).catch(e => {
    document.getElementById("sections").innerHTML = `<div class="loading">failed to load diff: ${esc(String(e))}</div>`;
  });
</script>

</body>
</html>
