<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{.Title}} — cohort review</title>
<link rel="stylesheet" href="/assets/diff2html.min.css">
<link rel="stylesheet" href="/assets/github.min.css" id="hl-light">
<link rel="stylesheet" href="/assets/github-dark.min.css" id="hl-dark" disabled>
<script src="/assets/diff2html.min.js"></script>
<script src="/assets/diff2html-ui.min.js"></script>
<style>
  /* Adapted from the "Cohort Review (diff2html)" prototype artifact. */
  :root {
    --bg:#f6f7f9; --panel:#fff; --sidebar:#f0f2f5; --border:#e3e6ec;
    --ink:#1a1f28; --ink-2:#48505d; --muted:#79828f; --accent:#4b5bd0; --accent-soft:#ecefff;
    --add-ink:#1a7f37; --del-ink:#c0362c;
    --mono: ui-monospace,"SF Mono","SFMono-Regular",Menlo,Consolas,monospace;
    --sans: system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#0c0f14; --panel:#12161d; --sidebar:#0e1218; --border:#232a34;
      --ink:#e6ecf3; --ink-2:#aeb8c6; --muted:#737d8c; --accent:#7d8bff; --accent-soft:#1a2036;
      --add-ink:#4ac26b; --del-ink:#f0655a; }
  }
  :root[data-theme="light"] { --bg:#f6f7f9;--panel:#fff;--sidebar:#f0f2f5;--border:#e3e6ec;
    --ink:#1a1f28;--ink-2:#48505d;--muted:#79828f;--accent:#4b5bd0;--accent-soft:#ecefff;--add-ink:#1a7f37;--del-ink:#c0362c; }
  :root[data-theme="dark"] { --bg:#0c0f14;--panel:#12161d;--sidebar:#0e1218;--border:#232a34;
    --ink:#e6ecf3;--ink-2:#aeb8c6;--muted:#737d8c;--accent:#7d8bff;--accent-soft:#1a2036;--add-ink:#4ac26b;--del-ink:#f0655a; }

  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body { background: var(--bg); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  .app { display: grid; grid-template-columns: var(--sidebar-w, 288px) 1fr; min-height: 100vh; }
  .sidebar { background: var(--sidebar); border-right: 1px solid var(--border); position: sticky; top: 0;
    height: 100vh; overflow-y: auto; padding: 18px 14px; }
  .rsz { position: absolute; top: 0; right: 0; width: 6px; height: 100%; cursor: col-resize; }
  .rsz:hover { background: var(--accent-soft); }
  body.resizing { cursor: col-resize; user-select: none; }
  .brand { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    color: var(--accent); font-weight: 700; margin-bottom: 4px; }
  .pr-t { font-size: 14.5px; font-weight: 650; line-height: 1.3; margin-bottom: 16px; }
  .nav-coh { margin-bottom: 6px; }
  .nch { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; cursor: pointer;
    font-size: 13px; font-weight: 600; }
  .nch:hover { background: var(--accent-soft); }
  .nch .swatch { width: 9px; height: 9px; border-radius: 3px; flex: none; }
  .nch .cnt { margin-left: auto; font-family: var(--mono); font-size: 11px; color: var(--muted);
    background: var(--panel); border: 1px solid var(--border); border-radius: 20px; padding: 1px 7px; }
  .nav-files { list-style: none; margin: 2px 0 8px; padding: 0 0 0 26px; }
  .nav-files li { font-family: var(--mono); font-size: 11.5px; color: var(--ink-2); padding: 3px 6px;
    border-radius: 5px; cursor: pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    direction: rtl; text-align: left; }
  .nav-files li:hover { background: var(--accent-soft); color: var(--accent); }
  .nav-files li span { direction: ltr; unicode-bidi: bidi-override; }

  /* Diffs use the full viewport in both layouts; only the header prose stays
     capped for readability. */
  main { min-width: 0; padding: 24px 28px 80px; }
  .top { margin-bottom: 20px; max-width: 1064px; }
  h1 { font-size: 22px; line-height: 1.2; letter-spacing: -.01em; margin: 8px 0 12px; font-weight: 700; }
  .walk { background: var(--panel); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: 10px; padding: 14px 16px; font-size: 14px; color: var(--ink-2); line-height: 1.55; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 12px; align-items: center;
    font-family: var(--mono); font-size: 12px; color: var(--muted); }
  .controls a { color: var(--accent); text-decoration: none; }
  .seg { display: inline-flex; border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
  .seg button { font-family: var(--mono); font-size: 11.5px; border: 0; background: var(--panel); color: var(--ink-2);
    padding: 4px 12px; cursor: pointer; }
  .seg button.on { background: var(--accent); color: #fff; }
  .loadf { display: inline-flex; gap: 6px; margin-left: auto; }
  .loadf input { font-family: var(--mono); font-size: 11.5px; width: 260px; padding: 4px 10px;
    background: var(--panel); color: var(--ink); border: 1px solid var(--border); border-radius: 20px; }
  .loadf input::placeholder { color: var(--muted); }
  .loadf button { font-family: var(--mono); font-size: 11.5px; border: 1px solid var(--border); border-radius: 20px;
    background: var(--panel); color: var(--ink-2); padding: 4px 12px; cursor: pointer; }
  .loadf button:disabled { color: var(--muted); cursor: wait; }

  .cohort { margin-top: 24px; scroll-margin-top: 12px; }
  .coh-head { display: flex; align-items: center; gap: 10px; padding: 8px 0 4px; cursor: pointer; }
  .coh-head .swatch { width: 11px; height: 11px; border-radius: 3px; flex: none; }
  .coh-head h2 { font-size: 16.5px; margin: 0; font-weight: 680; letter-spacing: -.01em; }
  .coh-head .stat { margin-left: auto; font-family: var(--mono); font-size: 12px; color: var(--muted);
    display: flex; gap: 8px; align-items: center; }
  .coh-head .chev { color: var(--muted); font-size: 12px; transition: transform .15s; }
  .cohort.collapsed .chev { transform: rotate(-90deg); }
  .coh-sum { font-size: 13.5px; color: var(--ink-2); margin: 0 0 12px 21px; line-height: 1.5; }
  .coh-claim { font-size: 13px; color: var(--ink-2); margin: -6px 0 12px 21px; line-height: 1.5; }
  .coh-claim b { color: var(--accent); font-weight: 650; }
  .kpill { font-family: var(--mono); font-size: 10px; font-weight: 600; border-radius: 20px;
    padding: 2px 8px; letter-spacing: .04em; flex: none; }
  .kpill.mechanical, .kpill.deletion { background: var(--sidebar); color: var(--ink-2); border: 1px solid var(--border); }
  .kpill.nonfix { background: var(--accent-soft); color: var(--accent); }
  .kpill.misc { background: var(--accent-soft); color: var(--del-ink); border: 1px solid var(--del-ink); }
  .cohort.misc .coh-head h2 { color: var(--del-ink); }
  .cohort.collapsed .coh-body { display: none; }
  .d2h-wrap { margin-bottom: 8px; }
  /* The hljs themes paint a block background on every highlighted element,
     which fights the diff's added/removed row colors — highlighting must
     only color tokens. */
  .d2h-wrap .hljs { background: transparent; padding: 0; }
  /* content-visibility lets the browser skip layout/paint for file cards that
     are scrolled off-screen — cheap virtualization for a long diff. The
     intrinsic-size is a rough placeholder so the scrollbar stays sane. */
  .d2h-wrap .d2h-file-wrapper { border-radius: 9px; overflow: hidden; margin-bottom: 12px; scroll-margin-top: 12px;
    content-visibility: auto; contain-intrinsic-size: 0 320px; }
  /* Large/generated files (lockfiles, minified assets, huge hunks) render as a
     placeholder card so one blob can't blow up the page; the expensive
     diff2html draw + highlight runs only if the user expands it. */
  .cr-file { scroll-margin-top: 12px; }
  .cr-big { background: var(--panel); border: 1px solid var(--border); border-radius: 9px; overflow: hidden;
    margin-bottom: 12px; }
  .cr-big .cr-name { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--ink-2);
    padding: 9px 14px; }
  .cr-show { display: block; width: 100%; text-align: left; cursor: pointer; font-family: var(--mono);
    font-size: 12px; color: var(--accent); background: var(--panel); border: 0;
    border-top: 1px solid var(--border); padding: 9px 14px; }
  .cr-show:hover { background: var(--accent-soft); }
  .coh-pending { color: var(--muted); font-family: var(--mono); font-size: 12px; padding: 16px 4px; }

  .theme-btn { position: fixed; top: 16px; right: 18px; z-index: 5; font-family: var(--mono); font-size: 11px;
    background: var(--panel); color: var(--ink-2); border: 1px solid var(--border); border-radius: 20px;
    padding: 5px 12px; cursor: pointer; }
  .loading { color: var(--muted); font-family: var(--mono); font-size: 13px; padding: 40px 0; }
  @media (max-width: 820px) { .app { grid-template-columns: 1fr; } .sidebar { display: none; } main { padding: 20px 14px 60px; } }
</style>
</head>
<body>

<button class="theme-btn" onclick="toggleTheme()">◐ theme</button>
<div class="app">
  <aside class="sidebar">
    <div class="rsz" id="rsz" title="drag to resize"></div>
    <div class="brand">Cohort Review</div>
    <div class="pr-t" id="pr-title"></div>
    <nav id="nav"></nav>
  </aside>
  <main>
    <div class="top">
      <div class="brand">Local · cohort-grouped diff · rendered by diff2html</div>
      <h1 id="h-title"></h1>
      <div class="walk" id="walk" hidden></div>
      <div class="controls">
        <span id="meta"></span>
        <a id="pr-link" target="_blank" rel="noopener" hidden>view on Bitbucket ↗</a>
        <span class="seg"><button id="ll" onclick="setFmt('line-by-line')">line-by-line</button><button id="sbs" onclick="setFmt('side-by-side')">side-by-side</button></span>
        <form class="loadf" action="/load"
          onsubmit="const b=this.querySelector('button'); b.disabled=true; b.textContent='grouping…';">
          <input name="pr" required placeholder="switch PR: paste bitbucket URL">
          <button>load</button>
        </form>
      </div>
    </div>
    <div id="sections"><div class="loading">loading diff…</div></div>
  </main>
</div>

<script>const PAGE = {{.Page}};</script>
<script>
  // Glue adapted from the prototype artifact; data comes from PAGE and the
  // diff from /diff.txt (fetched, never inlined — see server.go mux).
  const PALETTE = ["#4b5bd0", "#1a7f37", "#b0851a", "#8a5cd0", "#c04a72", "#2a8fa0", "#6a7a3f", "#4a7ac0"];
  const COHORTS = PAGE.cohorts.map((c, i) => ({ ...c, color: PALETTE[i % PALETTE.length] }));

  // fileBlocks: path → {block, parts}. parts mirrors Go's splitSegmentHunks:
  // parts[0] is the file header, hunk N is parts[N]. parts = null marks the
  // path unsplittable — hunk refs then render the whole block instead.
  let fileBlocks = {};

  // Paths whose whole block was already emitted this build: an unsplittable
  // path referenced from several cohorts renders at its FIRST ref only, so the
  // full diff stays on the page exactly once. Reset by every build().
  let renderedWhole = {};

  // markUnsplittable runs once, BEFORE any rendering: an out-of-range hunk
  // index means our split disagrees with the server's ground truth, so the
  // whole path degrades to unsplittable. Deciding upfront (not lazily inside
  // subFor) is what keeps the diff exactly-once — a lazy downgrade after an
  // earlier ref already rendered a subset would re-render those hunks.
  function markUnsplittable() {
    COHORTS.forEach(c => c.files.forEach(p => {
      const fb = fileBlocks[p.path];
      if (p.hunks && fb && fb.parts && p.hunks.some(n => n < 1 || n >= fb.parts.length)) fb.parts = null;
    }));
  }

  // subFor renders one cohort entry: a validated hunk subset, or the whole
  // block exactly once (at the path's first whole/unsplittable ref).
  function subFor(ref) {
    const fb = fileBlocks[ref.path];
    if (!fb) return "";
    if (ref.hunks && fb.parts) return fb.parts[0] + ref.hunks.map(n => fb.parts[n]).join("");
    if (renderedWhole[ref.path]) return "";
    renderedWhole[ref.path] = true;
    return fb.block;
  }
  const esc = s => s.replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

  let FMT = PAGE.format;
  let io = null;              // IntersectionObserver driving lazy cohort render
  const cohortState = [];     // per-cohort: { sub, parsed, present, rendered }

  // Type badges; "claim" is the default and untyped fallback buckets get no
  // badge either. Types come from the server-side enum (validType), so they
  // are safe as class names.
  const TYPES = { mechanical: "mechanical", deletion: "deletion", nonfix: "nonfix", misc: "undeclared ⚠" };
  const TYPE_HELP = {
    mechanical: "Same-shape churn folded together — verify the representative, skim the rest",
    deletion: "Deleted files — is the removal complete, who inherits the coverage, what is the transition risk?",
    nonfix: "Pins current behavior instead of changing it — review the decision not to fix",
    misc: "Not declared by the PR description — ask the author",
  };

  function build() {
    document.title = PAGE.title + " — cohort review";
    document.getElementById("pr-title").textContent = PAGE.title;
    document.getElementById("h-title").textContent = PAGE.title;
    const walk = document.getElementById("walk");
    walk.textContent = PAGE.walkthrough;
    walk.hidden = !PAGE.walkthrough;
    const link = document.getElementById("pr-link");
    link.href = PAGE.url;
    link.hidden = !PAGE.url;

    const nav = document.getElementById("nav");
    const sections = document.getElementById("sections");
    nav.innerHTML = ""; sections.innerHTML = "";
    renderedWhole = {};
    if (io) io.disconnect();
    cohortState.length = 0;
    let tAdd = 0, tDel = 0;
    const nFiles = new Set(COHORTS.flatMap(c => c.files.map(f => f.path))).size;

    COHORTS.forEach((c, ci) => {
      const subs = c.files.map(subFor);
      // Parsed per sub so renderCohort can spot large files BEFORE the
      // expensive diff2html draw + highlight pass touches them.
      const parsedSubs = subs.map(s => s ? Diff2Html.parse(s) : []);
      const parsed = parsedSubs.flat();
      const cAdd = parsed.reduce((s, f) => s + (f.addedLines || 0), 0);
      const cDel = parsed.reduce((s, f) => s + (f.deletedLines || 0), 0);
      tAdd += cAdd; tDel += cDel;

      // present: cohort file indices with a non-empty sub this build (computed
      // after subFor so an unsplittable downgrade is reflected). Each gets its
      // own host card in renderCohort, which is what the f-ci-fi anchors and
      // jumpFile rely on.
      const present = c.files.map((p, fi) => fi).filter(fi => subs[fi]);
      cohortState[ci] = { subs, parsedSubs, present, rendered: false };

      // Partial refs get a "k/M hunks" suffix.
      const label = p => {
        const fb = fileBlocks[p.path];
        const m = p.hunks && fb && fb.parts ? ` (${p.hunks.length}/${fb.parts.length - 1})` : "";
        return esc(p.path) + m;
      };
      nav.insertAdjacentHTML("beforeend",
        `<div class="nav-coh"><div class="nch" onclick="jump('coh-${ci}')">
          <span class="swatch" style="background:${c.color}"></span>${esc(c.name)}
          <span class="cnt">${c.files.length}</span></div>
          <ul class="nav-files">${c.files.map((p, fi) => `<li onclick="jumpFile(${ci}, ${fi})" title="${esc(p.path)}"><span>${label(p)}</span></li>`).join("")}</ul></div>`);

      // Only the section shell (header, stats, empty wrap) is built here. The
      // diff itself is drawn lazily by renderCohort when the cohort nears the
      // viewport — see the IntersectionObserver below.
      const ctype = Object.hasOwn(TYPES, c.type) ? c.type : "";
      // Handoff W2.3: mechanical and deletion cohorts start collapsed —
      // verifying the claim rarely needs the full diff open.
      const startCollapsed = c.type === "mechanical" || c.type === "deletion";
      sections.insertAdjacentHTML("beforeend",
        `<section class="cohort${ctype ? " " + ctype : ""}${startCollapsed ? " collapsed" : ""}" id="coh-${ci}" data-ci="${ci}">
          <div class="coh-head" onclick="toggleCohort(this.parentNode)">
            <span class="swatch" style="background:${c.color}"></span>
            <h2>${esc(c.name)}</h2>
            ${ctype ? `<span class="kpill ${ctype}" title="${TYPE_HELP[ctype]}">${TYPES[ctype]}</span>` : ""}
            <span class="stat"><span style="color:var(--add-ink)">+${cAdd}</span>
              <span style="color:var(--del-ink)">−${cDel}</span>
              <span>${parsed.length} files</span><span class="chev">▾</span></span>
          </div>
          <p class="coh-sum">${esc(c.summary || "")}</p>
          ${c.claim ? `<p class="coh-claim"><b>claim</b> ${esc(c.claim)}</p>` : ""}
          <div class="coh-body"><div class="d2h-wrap" id="wrap-${ci}"><div class="coh-pending">rendering…</div></div></div>
        </section>`);
    });

    document.getElementById("meta").innerHTML =
      `${COHORTS.length} cohorts · ${nFiles} files · <span style="color:var(--add-ink)">+${tAdd}</span> <span style="color:var(--del-ink)">−${tDel}</span>`;
    setFmtButtons();

    // Lazy render: drawing a cohort's diff (the diff2html build + highlight.js
    // pass) is the expensive part, so defer it until the cohort nears the
    // viewport. On a large PR only the visible cohorts ever get drawn, which is
    // what stops the page from janking. jump()/jumpFile() force a render before
    // scrolling to an off-screen target.
    if ("IntersectionObserver" in window) {
      io = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (e.isIntersecting) { renderCohort(+e.target.dataset.ci); io.unobserve(e.target); }
        }
      }, { rootMargin: "800px 0px" });
      document.querySelectorAll(".cohort").forEach(el => io.observe(el));
    } else {
      COHORTS.forEach((_, ci) => renderCohort(ci));
    }
    applyDark();
  }

  // toggleCohort: expanding must also draw — a collapsed cohort is skipped by
  // renderCohort, so the header is a render trigger, not just a class toggle.
  function toggleCohort(sec) {
    sec.classList.toggle("collapsed");
    if (!sec.classList.contains("collapsed")) renderCohort(+sec.dataset.ci);
  }

  // renderCohort draws one cohort's diff on demand (idempotent). Splitting the
  // draw out of build() is what makes lazy rendering possible. Each file gets
  // its own host div: large files are spotted from the parse BEFORE diff2html
  // draws or highlights anything, and get a placeholder instead — the
  // expensive draw runs only if the user expands them.
  function renderCohort(ci) {
    const st = cohortState[ci];
    if (!st || st.rendered) return;
    // Collapsed cohorts stay undrawn (rendered stays false) — the expensive
    // diff2html + highlight pass runs on first expand, not into a hidden box.
    if (document.getElementById(`coh-${ci}`).classList.contains("collapsed")) return;
    st.rendered = true;
    const wrap = document.getElementById(`wrap-${ci}`);
    wrap.innerHTML = "";
    st.present.forEach(fi => {
      const host = document.createElement("div");
      host.className = "cr-file";
      host.id = `f-${ci}-${fi}`;
      wrap.appendChild(host);
      const files = st.parsedSubs[fi];
      if (files.some(isBigFile)) bigFilePlaceholder(host, st.subs[fi], files);
      else drawDiff(host, st.subs[fi]);
    });
    applyDark();
  }

  // Diff2HtmlUI (rather than Diff2Html.html) so draw() runs the bundled
  // highlight.js over the rendered lines (highlight: true).
  function drawDiff(host, sub) {
    new Diff2HtmlUI(host, sub,
      { drawFileList: false, matching: "lines", outputFormat: FMT, highlight: true }).draw();
  }

  // diff2html keeps "dev/null" as the null side's name on adds/deletes.
  const fileName = f => (f.newName && !f.newName.includes("dev/null") ? f.newName : f.oldName) || "";

  // isBigFile flags the blobs that make big diffs janky: lockfiles, generated
  // and minified assets, and anything with a very large change count.
  function isBigFile(f) {
    const name = fileName(f);
    if (/(?:^|\/)(?:package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Gemfile\.lock|composer\.lock|Cargo\.lock|poetry\.lock|go\.sum)$/.test(name)) return true;
    if (/(?:^|\/)(?:schema\.rb|structure\.sql)$/.test(name)) return true;
    if (/(?:\.min\.js|\.min\.css|\.map|\.snap|\.pb\.go)$/.test(name)) return true;
    if (/(?:^|\/)(?:dist|vendor|node_modules)\//.test(name)) return true;
    return (f.addedLines || 0) + (f.deletedLines || 0) > 400;
  }

  // bigFilePlaceholder stands in for a large file's card; clicking "show"
  // draws the real diff in place.
  function bigFilePlaceholder(host, sub, files) {
    const add = files.reduce((s, f) => s + (f.addedLines || 0), 0);
    const del = files.reduce((s, f) => s + (f.deletedLines || 0), 0);
    host.innerHTML = `<div class="cr-big"><div class="cr-name">${esc(fileName(files[0]))}</div>
      <button class="cr-show">show large diff · +${add} −${del}</button></div>`;
    host.querySelector(".cr-show").onclick = () => { drawDiff(host, sub); applyDark(); };
  }

  function setFmt(f) {
    FMT = f;
    build();
  }
  function setFmtButtons() {
    document.getElementById("ll").classList.toggle("on", FMT === "line-by-line");
    document.getElementById("sbs").classList.toggle("on", FMT === "side-by-side");
  }
  function effectiveDark() {
    const t = document.documentElement.getAttribute("data-theme");
    return t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  }
  function applyDark() {
    const dark = effectiveDark();
    document.querySelectorAll(".d2h-wrapper").forEach(el => el.classList.toggle("d2h-dark-color-scheme", dark));
    document.getElementById("hl-light").disabled = dark;
    document.getElementById("hl-dark").disabled = !dark;
  }
  function jump(id) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove("collapsed");
    if (el.dataset.ci !== undefined) renderCohort(+el.dataset.ci);
    el.scrollIntoView({ behavior: "smooth", block: "start" });
  }
  // Jump to one file's diff card; falls back to the cohort header when the
  // file has no rendered block (e.g. its hunks were absent from the diff).
  function jumpFile(ci, fi) {
    const sec = document.getElementById(`coh-${ci}`);
    if (!sec) return;
    sec.classList.remove("collapsed");
    renderCohort(ci);
    (document.getElementById(`f-${ci}-${fi}`) || sec).scrollIntoView({ behavior: "smooth", block: "start" });
  }
  function toggleTheme() {
    document.documentElement.setAttribute("data-theme", effectiveDark() ? "light" : "dark");
    applyDark();
  }

  // Sidebar resize: drag the right edge; the chosen width persists.
  {
    const saved = localStorage.getItem("sidebarW");
    if (saved) document.documentElement.style.setProperty("--sidebar-w", saved);
    document.getElementById("rsz").addEventListener("mousedown", e => {
      e.preventDefault();
      document.body.classList.add("resizing");
      const move = ev => {
        const w = Math.min(Math.max(ev.clientX, 180), 640) + "px";
        document.documentElement.style.setProperty("--sidebar-w", w);
        localStorage.setItem("sidebarW", w);
      };
      const up = () => {
        document.body.classList.remove("resizing");
        removeEventListener("mousemove", move);
        removeEventListener("mouseup", up);
      };
      addEventListener("mousemove", move);
      addEventListener("mouseup", up);
    });
  }

  fetch("/diff.txt").then(r => r.text()).then(rawDiff => {
    // Index per-file blocks by the path SplitUnifiedDiff would assign (b/ side,
    // falling back to a/ for deletions) so cohort file lists match exactly.
    // A path seen in two segments is appended and marked unsplittable — its
    // concatenated block can't be hunk-indexed, matching the server's
    // bare-only rule for duplicate paths.
    rawDiff.split(/(?=^diff --git )/m).forEach(b => {
      const m = b.match(/^\+\+\+ b\/(.+)$/m) || b.match(/^--- a\/(.+)$/m);
      if (!m) return;
      const fb = fileBlocks[m[1]];
      if (fb) { fb.block += b; fb.parts = null; return; }
      fileBlocks[m[1]] = { block: b, parts: b.split(/(?=^@@ )/m) };
    });
    markUnsplittable();
    build();
  }).catch(e => {
    document.getElementById("sections").innerHTML = `<div class="loading">failed to load diff: ${esc(String(e))}</div>`;
  });
</script>

</body>
</html>
